# Copy this file to .env.deploy on the ECS host.
# Keep image tags in .env.images so automated deploys can update them without
# touching host-specific deploy settings.

# Runtime env file consumed by the API service.
AI_BIOWORKFLOW_RUNTIME_ENV_FILE=./.env.prod

# Public HTTPS entrypoint. Point the domain's A record at the ECS public IP
# before starting Caddy so it can complete ACME validation.
AI_BIOWORKFLOW_CADDY_IMAGE=caddy:2-alpine
AI_BIOWORKFLOW_SITE_ADDRESS=your-domain.example.com
AI_BIOWORKFLOW_TLS_EMAIL=you@example.com

# Caddy is the only public service; API and Web stay on the Docker network.
AI_BIOWORKFLOW_HTTP_BIND=0.0.0.0
AI_BIOWORKFLOW_HTTP_PORT=80
AI_BIOWORKFLOW_HTTPS_BIND=0.0.0.0
AI_BIOWORKFLOW_HTTPS_PORT=443
